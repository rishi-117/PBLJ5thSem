{
  "info": {
    "_postman_id": "7ac3f8b8-8dd4-40b9-b537-85c4c078a001",
    "name": "Student Management REST API",
    "description": "All six endpoints from Question 2. Run them top to bottom - the first request saves the new id into studentId, so the rest pick it up automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "studentId", "value": "1" },
    { "key": "course", "value": "Computer Science" }
  ],
  "item": [
    {
      "name": "Question 2 - REST API Endpoints",
      "item": [
        {
          "name": "1. Add a student",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Created with HTTP 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.id !== undefined) pm.collectionVariables.set('studentId', body.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "2. Retrieve all students",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students" }
        },
        {
          "name": "3. Retrieve student by ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/{{studentId}}" }
        },
        {
          "name": "4. Update student",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 21\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "5. Retrieve students by course",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/course/{{course}}" }
        },
        {
          "name": "6. Delete student",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Deleted with HTTP 204', function () { pm.response.to.have.status(204); });"] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/students/{{studentId}}" }
        }
      ]
    }
  ]
}
